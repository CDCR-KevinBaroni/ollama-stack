# Template for /etc/default/open-webui
#
# install.sh copies this to /etc/default/open-webui only if that file does not
# already exist. The real file is referenced by open-webui.service via
# EnvironmentFile= and is NOT committed -- it holds secrets.
#
# After install: edit /etc/default/open-webui, then
#     sudo systemctl restart open-webui

# Tavily web search API key (https://tavily.com/). Leave blank to disable web
# search at runtime; the unit's ENABLE_WEB_SEARCH=true will be a no-op without
# a valid key.
TAVILY_API_KEY=

# Optional: Google Custom Search Engine fallback. Uncomment WEB_SEARCH_ENGINE
# override in open-webui.service if you switch to this.
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ENGINE_ID=

# Optional: persistent signing keys. With these unset, Open WebUI generates
# ephemeral keys on each start, which invalidates user sessions across
# restarts. Generate with: openssl rand -hex 32
# SECRET_KEY=
# JWT_SECRET_KEY=
# WEB_SECRET_KEY=
